<Window x:Class="FileCopy.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileCopy" Height="680" Width="1000" MinHeight="420" MinWidth="700"
        FontSize="13" Background="#FAFBFC">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D7DE" />
        </Style>
        <Style x:Key="GreyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6D6D6D" />
        </Style>
        <Style x:Key="GreyTextRight" TargetType="TextBlock" BasedOn="{StaticResource GreyText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="打开" FontWeight="Bold" Click="Open_Click" />
            <Separator />
            <MenuItem Header="始终保留在此设备上(_A)" Click="Keep_Click" IsChecked="{Binding Pinned, Mode=OneWay}" />
            <MenuItem Header="释放空间(_F)" Click="FreeUp_Click" />
            <Separator />
            <MenuItem Header="下载到..." Click="DownloadTo_Click" />
            <MenuItem Header="重命名(_M)" Click="Rename_Click" IsEnabled="{Binding CanEdit}" />
            <MenuItem Header="删除(_D)" Click="Delete_Click" IsEnabled="{Binding CanEdit}" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="190" MinHeight="60" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Margin="10,10,10,6">
            <Button x:Name="UpButton" Content="← 上级" Style="{StaticResource ToolButton}" Click="Up_Click" />
            <Button Content="⟳ 刷新" Style="{StaticResource ToolButton}" Click="Refresh_Click" />
            <Button x:Name="UploadFilesButton" Content="⬆ 上传文件" Style="{StaticResource ToolButton}" Click="UploadFiles_Click" />
            <Button x:Name="UploadFolderButton" Content="⬆ 上传文件夹" Style="{StaticResource ToolButton}" Click="UploadFolder_Click" />
            <Button x:Name="NewFolderButton" Content="＋ 新建文件夹" Style="{StaticResource ToolButton}" Click="NewFolder_Click" />
            <Button Content="打开本地文件夹" Style="{StaticResource ToolButton}" Click="OpenLocal_Click" />
            <Button x:Name="BackupButton" Content="🗄 备份" Style="{StaticResource ToolButton}" Click="Backup_Click"
                    ToolTip="压缩 D:\Config、D:\Recipes、D:\MechanicalParameters 并上传到 backup 文件夹" />
            <Button Content="⚙ 设置" Style="{StaticResource ToolButton}" Click="Settings_Click" />
        </StackPanel>

        <!-- Breadcrumb -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,6">
            <ItemsControl x:Name="Breadcrumb">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="›" Margin="4,0" Foreground="Gray" VerticalAlignment="Center"
                                       Visibility="{Binding SeparatorVisibility}" />
                            <Button Content="{Binding Name}" Tag="{Binding Rel}" Click="Crumb_Click"
                                    Background="Transparent" BorderThickness="0" Padding="4,2" Cursor="Hand" FontSize="14" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ReadOnlyHint" Text="🔒 只读文件夹：只能下载，不能上传、新建、重命名或删除" Foreground="#8A5300"
                       Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>

        <!-- File list (Explorer style) -->
        <Grid Grid.Row="2" Margin="10,0,10,0">
            <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" AllowDrop="True"
                      HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False"
                      CanUserResizeRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
                      RowHeight="24" Background="White" BorderBrush="#E5E5E5" HorizontalScrollBarVisibility="Disabled"
                      FontFamily="Microsoft YaHei UI" FontSize="12"
                      MouseDoubleClick="FilesGrid_MouseDoubleClick" Drop="FilesGrid_Drop" DragOver="FilesGrid_DragOver"
                      KeyDown="FilesGrid_KeyDown">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="#4C607A" />
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="BorderBrush" Value="#E5E5E5" />
                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Background" Value="White" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5F3FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CCE8FF" />
                                <Setter Property="BorderBrush" Value="#99D1FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="Black" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" Padding="8,0">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="名称" Width="*" MinWidth="200" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="状态" Width="70" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="14" ToolTip="{Binding StatusText}"
                                           VerticalAlignment="Center" Background="Transparent" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="修改日期" Binding="{Binding MtimeText}" Width="150" SortMemberPath="Mtime"
                                        ElementStyle="{StaticResource GreyText}" />
                    <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" Width="130"
                                        ElementStyle="{StaticResource GreyText}" />
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="110" SortMemberPath="Size"
                                        ElementStyle="{StaticResource GreyTextRight}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyHint" Text="此文件夹为空 —— 把文件拖到这里即可上传" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- Transfers / log -->
        <TabControl Grid.Row="4" Margin="10,0,10,4">
            <TabItem Header="传输">
                <DataGrid x:Name="TransfersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False"
                          RowHeight="22" BorderThickness="0" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="方向" Binding="{Binding DirectionText}" Width="70" />
                        <DataGridTextColumn Header="文件" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90" />
                        <DataGridTemplateColumn Header="进度" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="12" Margin="2,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="速度" Binding="{Binding SpeedText}" Width="100" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="日志">
                <ListBox x:Name="LogList" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" />
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="5" Background="#F0F2F5" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="LocalUsageText" DockPanel.Dock="Right" Foreground="#555" />
                <TextBlock x:Name="StatusText" Text="未连接" Foreground="#555" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
